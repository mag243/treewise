# Pinned tool versions for the Treewise development environment.
# tools/setup.sh verifies or installs exactly these; tools/build.sh uses them.
# Change a version here, run tools/setup.sh again, and commit this file.

# Xcode, which also provides Swift, swift-format, and the SDKs. setup.sh cannot
# install it; it checks that the selected Xcode matches this major.minor version.
# https://developer.apple.com/xcode/
XCODE_VERSION="27.2"

# The Xcode that CI uses: the newest one on the GitHub macOS runner image, which
# lags behind the local pin (ADR 0010). setup.sh checks this one when CI=true.
CI_XCODE_VERSION="26.6"

# The iOS Simulator the iOS tests run on: the lowest supported iOS (ADR 0007)
# on the device the test plan names (PLAN.md §9.6).
IOS_SIMULATOR_OS="18.5"
IOS_SIMULATOR_DEVICE_TYPE="iPad Pro 13-inch (M4)"
IOS_SIMULATOR_NAME="Treewise iPad Pro 13-inch (M4)"

# The second iPad the UI review looks at (ADR 0115): a smaller screen on the newest iOS,
# where the sidebar stands beside the folder in portrait and leaves the folder narrow.
IOS_REVIEW_SIMULATOR_OS="27.0"
IOS_REVIEW_SIMULATOR_DEVICE_TYPE="iPad Pro 11-inch (M5)"
IOS_REVIEW_SIMULATOR_NAME="Treewise iPad Pro 11-inch (M5)"

# The iPhone the iPhone's UI tests run on (ADR 0132): the lowest supported iOS, as the
# pinned iPad, on a Pro Max, whose landscape width is regular and height compact.
IOS_IPHONE_SIMULATOR_OS="18.5"
IOS_IPHONE_SIMULATOR_DEVICE_TYPE="iPhone 16 Pro Max"
IOS_IPHONE_SIMULATOR_NAME="Treewise iPhone 16 Pro Max"

# The iPhone the App Store's iPhone screenshots are made on (ADR 0145): the medium display
# with Dynamic Island, 1206 × 2622, the size App Store Connect requires.
IOS_APPSTORE_IPHONE_SIMULATOR_OS="18.5"
IOS_APPSTORE_IPHONE_SIMULATOR_DEVICE_TYPE="iPhone 16 Pro"
IOS_APPSTORE_IPHONE_SIMULATOR_NAME="Treewise iPhone 16 Pro"

# The iPhone Duo the Duo's UI tests run on (ADR 0133). It runs only on a runtime of its own,
# named by its identifier, beside the general one of the same iOS.
IOS_DUO_SIMULATOR_OS="27.2"
IOS_DUO_SIMULATOR_RUNTIME="com.apple.CoreSimulator.SimRuntime.iOS-27-2-iPhone19-4"
IOS_DUO_SIMULATOR_DEVICE_TYPE="iPhone Duo"
IOS_DUO_SIMULATOR_NAME="Treewise iPhone Duo"

# Command-line tools from Homebrew. Homebrew installs its current release; these
# are the minimum versions setup.sh accepts.
BASH_MIN_VERSION="4.4"
XCBEAUTIFY_MIN_VERSION="3.0"
SHELLCHECK_MIN_VERSION="0.10"
SWIFTLINT_MIN_VERSION="0.65"
# duoctl folds the iPhone Duo simulator for its App Store screenshots (ADR 0145),
# from the skarol/tap tap. https://github.com/skarol/duoctl
DUOCTL_MIN_VERSION="0.2.1"

# dmgbuild, which lays out the release disk image without Finder (ADR 0034).
# Installed at exactly this version into build/tools/dmgbuild by setup.sh, or by
# tools/build.sh package when missing. https://pypi.org/project/dmgbuild/
DMGBUILD_VERSION="1.6.7"
