        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” can’t be ejected. %2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” kan niet worden verwijderd. %2$@"
          }
        }
      }
    },
    "“%@” can’t be found." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde nicht gefunden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kan niet worden gevonden."
          }
        }
      }
    },
    "“%@” can’t be moved to the Trash because its volume has no Trash." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht in den Papierkorb gelegt werden, weil das Volume keinen Papierkorb hat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan niet naar de prullenmand, omdat het volume geen prullenmand heeft."
          }
        }
      }
    },
    "“%@” changed since, so this can’t be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde inzwischen geändert, daher kann dies nicht widerrufen werden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is sindsdien gewijzigd, dus dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
    "“%@” could not be copied completely, so it stayed where it was." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht vollständig kopiert werden und ist deshalb geblieben, wo es war."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kon niet volledig worden gekopieerd en is daarom gebleven waar het was."
          }
        }
      }
    },
    "“%@” holds a field with a format it does not take." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ enthält ein Feld mit einem Format, das es nicht annimmt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ bevat een veld met een opmaak die het niet aanneemt."
          }
        }
      }
    },
    "“%@” is damaged and can’t be extracted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist beschädigt und kann nicht entpackt werden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is beschadigd en kan niet worden uitgepakt."
          }
        }
      }
    },
    "“%@” is outside the folders Treewise may use now." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ liegt außerhalb der Ordner, die Treewise jetzt verwenden darf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ valt buiten de mappen die Treewise nu mag gebruiken."
          }
        }
      }
    },
    "“%@” is protected with a password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist mit einem Passwort geschützt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is beveiligd met een wachtwoord."
          }
        }
      }
    },
    "“%@” isn’t in a format Treewise can extract." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat kein Format, das Treewise entpacken kann."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ heeft geen formaat dat Treewise kan uitpakken."
          }
        }
      }
    },
    "“%@” repeats for each month, quarter or half, which only a folder below the top one can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wiederholt sich für jeden Monat, jedes Quartal oder Halbjahr, und das kann nur ein Ordner unter dem obersten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ herhaalt zich per maand, kwartaal of halfjaar, en dat kan alleen een map onder de bovenste."
          }
        }
      }
    },
    "“%@” repeats inside a folder that repeats already; a folder can repeat once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wiederholt sich in einem Ordner, der sich schon wiederholt; ein Ordner kann sich nur einmal wiederholen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ herhaalt zich in een map die zich al herhaalt; een map kan zich maar één keer herhalen."
          }
        }
      }
    },
    "“%@” starts with a dot, so Finder would hide it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ beginnt mit einem Punkt, daher würde der Finder den Ordner ausblenden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ begint met een punt, dus Finder zou de map verbergen."
          }
        }
      }
    }
  },
  "version" : "1.1"
}