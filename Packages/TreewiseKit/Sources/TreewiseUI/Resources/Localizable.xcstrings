        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een keuze tussen < en > kan geen andere keuze bevatten, en geen [ ] met een veld"
          }
        }
      }
    },
    "A choice between < and > has an empty part" : {
      "localizations" : {
