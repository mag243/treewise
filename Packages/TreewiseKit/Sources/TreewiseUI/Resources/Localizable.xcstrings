{
  "sourceLanguage" : "en",
  "strings" : {
    "%@, %@" : {
      "comment" : "Status bar: the selection, then its total size",
      "shouldTranslate" : false
    },
    "%@, %@ available" : {
      "comment" : "Status bar: the item count, then the free space on the volume, e.g. 245.3 GB",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ verfügbar"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ beschikbaar"
          }
        }
      }
    },
    "%lld items" : {
      "comment" : "Status bar: how many items the folder shows",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Objekt"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Objekte"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items"
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld onderdeel"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld onderdelen"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %@ selected" : {
      "comment" : "Status bar while items are selected: the selected count, then the item count, e.g. 8 items",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$@ ausgewählt"
