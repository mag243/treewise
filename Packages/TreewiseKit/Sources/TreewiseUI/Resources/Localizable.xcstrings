            "value" : "{seq} kan alleen in de bovenste map staan; schrijf genummerde mappen als 01 Intake."
          }
        }
      }
    },
    "“%@” cannot be a folder’s name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann kein Ordnername sein."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan geen naam van een map zijn."
          }
        }
      }
    },
    "“%@” can’t be ejected. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ kann nicht ausgeworfen werden. %2$@"
          }
