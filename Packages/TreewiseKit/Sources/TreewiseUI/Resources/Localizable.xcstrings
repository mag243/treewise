    },
    "“%@” can’t be ejected. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ kann nicht ausgeworfen werden. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” can’t be ejected. %2$@"
          }
