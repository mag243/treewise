        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld van %2$@ geselecteerd"
          }
        }
      }
    },
    "An item named “%@” already exists in this location." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An diesem Ort gibt es bereits ein Objekt mit dem Namen „%@“."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat al een onderdeel met de naam ‘%@’ op deze locatie."
          }
        }
      }
    },
    "Copy" : {
