          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” kan niet worden verwijderd. %2$@"
          }
        }
      }
    },
    "“%@” can’t be found." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde nicht gefunden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kan niet worden gevonden."
          }
        }
      }
    },
    "“%@” can’t be moved to the Trash because its volume has no Trash." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht in den Papierkorb gelegt werden, weil das Volume keinen Papierkorb hat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan niet naar de prullenmand, omdat het volume geen prullenmand heeft."
          }
        }
      }
    },
    "“%@” could not be copied completely, so it stayed where it was." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht vollständig kopiert werden und ist deshalb geblieben, wo es war."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kon niet volledig worden gekopieerd en is daarom gebleven waar het was."
          }
        }
      }
    },
    "“%@” is outside the folders Treewise may use now." : {
      "comment" : "Message when an operation fails; %@ is the item's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ liegt außerhalb der Ordner, die Treewise jetzt verwenden darf."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ valt buiten de mappen die Treewise nu mag gebruiken."
          }
        }
      }
