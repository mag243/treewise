        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach : folgt ein Datumsformat; 4, 2-4, 2,4,6, 5- oder 001- nach {seq}, mit :3 für eine Breite; yy nach {year}; eine Zahl nach {folder}; oder lower, upper oder title"
