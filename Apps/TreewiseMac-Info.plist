	<key>SUPublicEDKey</key>
	<string>PcPBmr57lEVBurMNhOVc7S+Jnzx/RuULFSXrVn6Iifg=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
