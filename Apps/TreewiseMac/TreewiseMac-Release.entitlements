<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Release build's entitlements: the app's own keychain group, for the data protection
     keychain that keeps the licence dates (ADR 0071). It needs the Developer ID provisioning
     profile the export uses; a Debug build, signed ad hoc, cannot carry it. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>SP255JXLVN.me.m-domain.treewise</string>
	</array>
</dict>
</plist>
