            "value" : "{%@}"
          }
        }
      }
    },
    "{seq} can only be in the top folder; write numbered folders as 01 Intake." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{seq} kann nur im obersten Ordner stehen; schreibe nummerierte Ordner als 01 Intake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{seq} kan alleen in de bovenste map staan; schrijf genummerde mappen als 01 Intake."
          }
        }
      }
    },
    "“%@” cannot be a folder’s name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann kein Ordnername sein."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan geen naam van een map zijn."
          }
        }
      }
    },
    "“%@” has a newer version:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von „%@“ gibt es eine neuere Version:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van “%@” is er een nieuwere versie:"
          }
        }
      }
    },
    "“%@” holds a field with a format it does not take." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ enthält ein Feld mit einem Format, das es nicht annimmt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ bevat een veld met een opmaak die het niet aanneemt."
          }
        }
      }
    },
    "“%@” in %@ could not be renamed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ in %2$@ konnte nicht umbenannt werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” in %2$@ could not be renamed"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De naam van ‘%1$@’ in %2$@ kon niet worden gewijzigd"
          }
        }
      }
    },
    "“%@” in %@ looks like “%@” in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ in %2$@ sieht aus wie „%3$@“ in %4$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” in %2$@ looks like “%3$@” in %4$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ in %2$@ lijkt op ‘%3$@’ in %4$@."
          }
        }
      }
    },
    "“%@” repeats for each month, quarter or half, which only a folder below the top one can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wiederholt sich für jeden Monat, jedes Quartal oder Halbjahr, und das kann nur ein Ordner unter dem obersten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ herhaalt zich per maand, kwartaal of halfjaar, en dat kan alleen een map onder de bovenste."
          }
        }
      }
    },
    "“%@” repeats inside a folder that repeats already; a folder can repeat once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wiederholt sich in einem Ordner, der sich schon wiederholt; ein Ordner kann sich nur einmal wiederholen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ herhaalt zich in een map die zich al herhaalt; een map kan zich maar één keer herhalen."
          }
        }
      }
    },
    "“%@” starts with a dot, so Finder would hide it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ beginnt mit einem Punkt, daher würde der Finder den Ordner ausblenden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ begint met een punt, dus Finder zou de map verbergen."
          }
        }
      }
    }
  },
  "version" : "1.1"
