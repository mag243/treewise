    "Each folder starts again with the add-ons that are on in new folders, and its pattern is recognized again. Saved patterns stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Ordner beginnt wieder mit den Add-ons, die in neuen Ordnern eingeschaltet sind, und sein Muster wird neu erkannt. Gesicherte Muster bleiben erhalten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke map begint opnieuw met de add-ons die aan staan in nieuwe mappen, en het patroon wordt opnieuw herkend. Bewaarde patronen blijven."
          }
        }
      }
    },
