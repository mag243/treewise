    "Add a folder from On My iPad, iCloud Drive, a drive or another app to browse it in Treewise." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Ordner aus „Auf meinem iPad“, iCloud Drive, einem Laufwerk oder einer anderen App hinzu, um ihn in Treewise zu durchsuchen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een map toe uit Op mijn iPad, iCloud Drive, een schijf of een andere app om die in Treewise te bekijken."
          }
        }
      }
    },
