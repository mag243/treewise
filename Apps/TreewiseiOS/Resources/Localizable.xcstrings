            "value" : "De map kan niet worden toegevoegd."
          }
        }
      }
    },
    "The folders in it, at every depth. Files are not saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ordner darin, in jeder Tiefe. Dateien werden nicht gesichert."
