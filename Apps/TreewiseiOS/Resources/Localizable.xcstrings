      }
    },
    "The pattern is kept under this name, to pick in other folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Muster wird unter diesem Namen gesichert, um es in anderen Ordnern auszuwählen."
