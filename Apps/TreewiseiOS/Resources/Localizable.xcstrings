        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het patroon wordt onder deze naam bewaard, om in andere mappen te kiezen."
          }
        }
      }
    },
    "This location has no Trash, so this can’t be undone." : {
      "localizations" : {
